[sqlfluff]
dialect = duckdb
templater = jinja
max_line_length = 120
exclude_rules = LT05

[sqlfluff:templater:jinja:macros]
ref = {% macro ref(model_name) %}{{ model_name }}{% endmacro %}
source = {% macro source(source_name, table_name) %}{{ source_name }}_{{ table_name }}{% endmacro %}
config = {% macro config(materialized=none, schema=none, alias=none, tags=none, unique_key=none, severity=none) %}{% endmacro %}
amenity_flag = {% macro amenity_flag(amenities_column, amenity_name) %}coalesce(json_contains({{ amenities_column }}, '"{{ amenity_name }}"'), false){% endmacro %}
clean_currency = {% macro clean_currency(column_name) %}try_cast({{ column_name }} as decimal(10, 2)){% endmacro %}
